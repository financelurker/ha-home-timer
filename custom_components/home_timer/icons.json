{
  "entity": {
    "sensor": {
      "timers": {
        "default": "mdi:timer-outline",
        "range": {
          "0": "mdi:timer-off-outline",
          "1": "mdi:timer-outline"
        }
      },
      "station": {
        "default": "mdi:timer-outline",
        "state": {
          "idle": "mdi:timer-off-outline",
          "active": "mdi:timer-sand",
          "paused": "mdi:timer-pause-outline",
          "ringing": "mdi:bell-ring"
        }
      },
      "ends": {
        "default": "mdi:timer-alert-outline"
      },
      "runs": {
        "default": "mdi:counter"
      },
      "usual_duration": {
        "default": "mdi:timer-sand-complete"
      }
    },
    "binary_sensor": {
      "ringing": {
        "default": "mdi:bell-outline",
        "state": {
          "on": "mdi:bell-ring"
        }
      },
      "appliance_running": {
        "default": "mdi:power-plug-outline",
        "state": {
          "on": "mdi:power-plug"
        }
      }
    },
    "button": {
      "acknowledge_all": {
        "default": "mdi:bell-check-outline"
      },
      "start_preset": {
        "default": "mdi:play-circle-outline"
      },
      "pause_resume": {
        "default": "mdi:play-pause"
      },
      "add_minute": {
        "default": "mdi:timer-plus-outline"
      },
      "stop": {
        "default": "mdi:stop-circle-outline"
      },
      "start_custom": {
        "default": "mdi:timer-play-outline"
      },
      "done_now": {
        "default": "mdi:check-circle-outline"
      }
    },
    "todo": {
      "ringing_timers": {
        "default": "mdi:bell-ring-outline"
      }
    },
    "number": {
      "custom_minutes": {
        "default": "mdi:timer-cog-outline"
      }
    },
    "text": {
      "save_preset": {
        "default": "mdi:content-save-outline"
      }
    }
  },
  "services": {
    "start": {
      "service": "mdi:timer-play-outline"
    },
    "pause": {
      "service": "mdi:timer-pause-outline"
    },
    "resume": {
      "service": "mdi:timer-play-outline"
    },
    "add_time": {
      "service": "mdi:timer-plus-outline"
    },
    "subtract_time": {
      "service": "mdi:timer-minus-outline"
    },
    "cancel": {
      "service": "mdi:timer-cancel-outline"
    },
    "acknowledge": {
      "service": "mdi:bell-check-outline"
    },
    "assign": {
      "service": "mdi:timer-marker-outline"
    }
  }
}
